<?xml version='1.0' encoding='UTF-8'?>
<!--
  SPDX-License-Identifier: MIT

  AEpmxRigidBodyJointTemplate.xml

  Attribute-Editor template for the per-joint `pmxRigidBodyJoint` node: the
  PMX joint data is shown as the node's primary AE content with proper labels
  (instead of one flat "Extra Attributes" list).  The node's DAG transform IS
  the joint frame, so the standard transform controls (Translate/Rotate) at
  the top of the editor reposition the constraint; this template groups the
  joint data (Bodies / Type / Limits / Springs / Display).

  The Maya AE auto-discovers AE<NodeType>Template.xml from
  MAYA_CUSTOM_TEMPLATE_PATH or <MAYA_LOCATION>/scripts/AETemplates/ (see
  showEditor.mel:templateDirs / AEvalidatedTemplateName); the CMake build
  installs this file into <module>/scripts/AETemplates/ and MayaMMD.mod puts
  that folder on MAYA_CUSTOM_TEMPLATE_PATH.
-->
<templates>
  <using package='maya'/>
  <template name='AEpmxRigidBodyJoint'>
    <attribute name='jointNameLocal' type='maya.string'>
      <label>Local Name</label>
    </attribute>
    <attribute name='jointNameUniversal' type='maya.string'>
      <label>Universal Name</label>
    </attribute>
    <attribute name='jointType' type='maya.enum'>
      <label>Type</label>
    </attribute>
    <attribute name='jointBodyA' type='maya.long'>
      <label>Body A</label>
    </attribute>
    <attribute name='jointBodyB' type='maya.long'>
      <label>Body B</label>
    </attribute>
    <attribute name='jointLinearMin' type='maya.double3'>
      <label>Linear Min</label>
    </attribute>
    <attribute name='jointLinearMax' type='maya.double3'>
      <label>Linear Max</label>
    </attribute>
    <attribute name='jointAngularMin' type='maya.double3'>
      <label>Angular Min</label>
    </attribute>
    <attribute name='jointAngularMax' type='maya.double3'>
      <label>Angular Max</label>
    </attribute>
    <attribute name='jointLinearSpring' type='maya.double3'>
      <label>Linear Spring</label>
    </attribute>
    <attribute name='jointAngularSpring' type='maya.double3'>
      <label>Angular Spring</label>
    </attribute>
    <attribute name='drawMode' type='maya.enum'>
      <label>Draw Mode</label>
    </attribute>
  </template>

  <view name='Body' template='AEpmxRigidBodyJoint'>
    <group name='joint'>
      <label>Joint</label>
      <property name='jointNameLocal'/>
      <property name='jointNameUniversal'/>
      <property name='jointType'/>
      <property name='jointBodyA'/>
      <property name='jointBodyB'/>
    </group>
    <group name='limits'>
      <label>Limits</label>
      <property name='jointLinearMin'/>
      <property name='jointLinearMax'/>
      <property name='jointAngularMin'/>
      <property name='jointAngularMax'/>
    </group>
    <group name='springs'>
      <label>Springs</label>
      <property name='jointLinearSpring'/>
      <property name='jointAngularSpring'/>
    </group>
    <group name='display'>
      <label>Display</label>
      <property name='drawMode'/>
    </group>
  </view>
</templates>
