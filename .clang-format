# MayaMMD — C++ code formatting configuration
# LLVM base style with 4-space indent (matching existing code).
#
# Usage:
#   hatch run format-cpp        # format in-place
#   hatch run format-cpp-check  # dry-run check (CI)

BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# Break before braces: attach to namespace/class/function opening
BreakBeforeBraces: Allman

# Braces are mandatory on every control statement: clang-format inserts the
# missing ones (if/else/for/while/do), and the AllowShort* options below stop
# any one-line body or block from being collapsed back onto a single line.
InsertBraces: true
RemoveBracesLLVM: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# Pointer alignment: left (int *ptr)
PointerAlignment: Left

# Include sorting
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# Spacing
SpaceAfterCStyleCast: true
SpaceBeforeAssignmentOperators: true
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Align trailing comments
AlignTrailingComments: true

# Allow short functions/lambdas on a single line
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
