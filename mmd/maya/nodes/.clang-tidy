---
# clang-tidy configuration for the Maya plugin adapter (mmd/maya/nodes).
#
# Same high-value profile as the project root, with three checks relaxed that
# are pure noise against the Maya API:
#   - performance-unnecessary-copy-initialization:  Maya returns value types
#     everywhere (MMatrix, MDataHandle, ...); 80+ "bind to const ref" hints.
#   - cppcoreguidelines-pro-bounds-array-to-pointer-decay:  the Maya SDK is
#     built on raw C arrays (asDouble3() -> const double*, C-array params).
#   - cppcoreguidelines-pro-bounds-constant-array-index:  the node indexes
#     Maya attribute arrays (aBodyMaskGroup[g], compound children) with loop
#     counters — idiomatic for the API.
# The Maya-free core (mmd/core) keeps the full strict profile.
Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  clang-diagnostic-*,
  cppcoreguidelines-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -bugprone-throwing-static-initialization,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -misc-const-correctness,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -performance-unnecessary-copy-initialization,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers
HeaderFilterRegex: 'mmd/maya/nodes/.*'
...
