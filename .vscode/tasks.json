        {
            "label": "Test: CMD",
            "type": "shell",
            "command": "ctest --preset default -R maya-integration-cmd",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Multi",
            "type": "shell",
            "command": "ctest --preset default -R maya-integration-multi",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Context",
            "type": "shell",
            "command": "ctest --preset default -R maya-integration-context",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
